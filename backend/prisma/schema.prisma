generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PGURL")
}

model GroceryItem {
  id              Int       @id @default(autoincrement())
  name            String
  category        String
  price           Float
  quantityInStock Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@map("grocery_items") // Maps the model to the "grocery_items" table in PostgreSQL
}

model User {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}